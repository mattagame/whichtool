{
  "name": "whichtool",
  "version": "0.1.0",
  "description": "Does the model actually pick the right tool from your MCP server?",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "llm-evaluation",
    "tool-selection",
    "tool-calling",
    "ai-agents",
    "cli",
    "llm"
  ],
  "author": {
    "name": "Matt A. Game",
    "url": "https://github.com/mattagame"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mattagame/whichtool.git"
  },
  "homepage": "https://github.com/mattagame/whichtool#readme",
  "bugs": {
    "url": "https://github.com/mattagame/whichtool/issues"
  },
  "packageManager": "bun@1.3.14",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "whichtool": "./dist/cli/main.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "import": "./dist/config.js"
    },
    "./schemas/common": "./schemas/common.schema.json",
    "./schemas/config": "./schemas/config.schema.json",
    "./schemas/task-set": "./schemas/task-set.schema.json",
    "./schemas/inspect-report": "./schemas/inspect-report.schema.json",
    "./schemas/run-report": "./schemas/run-report.schema.json",
    "./schemas/diff-report": "./schemas/diff-report.schema.json",
    "./schemas/mcp-result": "./schemas/mcp-result.schema.json"
  },
  "files": [
    "dist",
    "schemas",
    "README.md",
    "README.it.md",
    "LICENSE.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:binaries": "bun run ./scripts/build-binaries.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "bun test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "npm run build",
    "dev": "bun run ./src/cli/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bun": "^1.4.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.9.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
