{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mattagame/whichtool/main/schemas/config.schema.json",
  "title": "whichtool configuration",
  "type": "object",
  "properties": {
    "target": { "$ref": "#/$defs/target" },
    "tasks": { "$ref": "#/$defs/nonEmptyString" },
    "provider": {
      "type": "object",
      "properties": {
        "name": { "$ref": "#/$defs/nonEmptyString" },
        "model": { "$ref": "#/$defs/nonEmptyString" },
        "baseUrl": { "$ref": "#/$defs/nonEmptyString" }
      },
      "required": ["name"],
      "additionalProperties": false
    },
    "trials": {
      "type": "object",
      "properties": {
        "repeat": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "permute": { "type": "boolean" },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 64 },
        "reasoningEffort": { "$ref": "#/$defs/nonEmptyString" },
        "seed": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "thresholds": {
      "type": "object",
      "properties": {
        "minAccuracy": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxOverTrigger": { "type": "number", "minimum": 0, "maximum": 1 },
        "maxContextTokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "maxErrorRate": { "type": "number", "minimum": 0, "maximum": 1 },
        "minScored": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "additionalProperties": false
    },
    "report": {
      "type": "object",
      "properties": {
        "formats": {
          "type": "array",
          "items": {
            "enum": ["terminal", "json", "markdown", "html", "junit", "badge"]
          }
        },
        "out": { "$ref": "#/$defs/nonEmptyString" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "nonEmptyString": { "type": "string", "pattern": "\\S" },
    "stringRecord": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "transport": { "const": "snapshot" },
            "path": { "$ref": "#/$defs/nonEmptyString" }
          },
          "required": ["transport", "path"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "transport": { "enum": ["http", "legacy-sse"] },
            "url": { "$ref": "#/$defs/nonEmptyString" },
            "headers": { "$ref": "#/$defs/stringRecord" }
          },
          "required": ["transport", "url"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "transport": { "const": "stdio" },
            "command": { "$ref": "#/$defs/nonEmptyString" },
            "args": { "type": "array", "items": { "type": "string" } },
            "env": { "$ref": "#/$defs/stringRecord" },
            "cwd": { "$ref": "#/$defs/nonEmptyString" }
          },
          "required": ["transport", "command"],
          "additionalProperties": false
        }
      ]
    }
  }
}
